POSTGRES_DB=regwatch
POSTGRES_USER=regwatch
POSTGRES_PASSWORD=replace-with-local-random-password
MINIO_ROOT_USER=regwatch
MINIO_ROOT_PASSWORD=replace-with-another-local-random-password
SNAPSHOT_BUCKET=regwatch-snapshots

# Replace the contact placeholder before enabling any live source.
CRAWL_CONTACT_EMAIL=contact@example.invalid
CRAWL_TIMEOUT_S=15
CRAWL_DELAY_S=2
CRAWL_MAX_RETRIES=2
CRAWL_BACKOFF_S=1
CRAWL_RETRY_AFTER_CAP_S=60
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_RESPONSE_BYTES=10485760
ROBOTS_CACHE_TTL_S=3600

# S3 API uses MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above for local development.
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_CONNECT_TIMEOUT_S=3
S3_READ_TIMEOUT_S=10
S3_MAX_ATTEMPTS=3
